# Compiled binaries / shared objects
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries and coverage output
*.test
*.out
coverage.txt
coverage.html

# Local build artifacts
/bin/
/dist/
/build/

# Go workspace files (per-developer)
go.work
go.work.sum

# IDE / editor cruft
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Local config / secrets
.env
.env.*
*.local

# Claude Code local state
.claude/

# Built by `make binary`.
/tunneld

# A cached tunnel spec, which a run writes into its working directory unless
# --cache-dir says otherwise. Credentials, and named rather than caught by the
# *.local line above, so it needs its own entry.
TUNNEL.env

# Subagent-driven development scratch: ledgers, briefs, review packages.
# Regenerated per plan; the git history is the durable record.
.superpowers/
