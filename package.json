{
  "name": "tunneld",
  "version": "0.0.0",
  "description": "Slice and share your machine on a public URL: a port, a shell, a coding agent, a container, or your whole workspace. One command, no account.",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "tunnel",
    "localhost",
    "expose",
    "share",
    "public-url",
    "cloudflare-tunnel",
    "web-terminal",
    "terminal",
    "shell",
    "tty",
    "docker",
    "coding-agent",
    "claude-code",
    "dev-server",
    "tunnel-pizza",
    "tunneld"
  ],
  "homepage": "https://tunnel.pizza",
  "bugs": {
    "url": "https://github.com/tunnel-pizza/tunneld/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tunnel-pizza/tunneld.git"
  },
  "license": "FSL-1.1-MIT",
  "author": "Scaffoldly <legal@scaffold.ly> (https://github.com/scaffoldly)",
  "type": "commonjs",
  "bin": "v1/v1.cjs",
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "files": [
    "v1/v1.cjs",
    "dist/tunneld-*",
    "dist/THIRD_PARTY_LICENSES",
    "!dist/*.sigstore",
    ".claude-plugin/*"
  ],
  "scripts": {
    "dev": "make -s host && node v1/v1.cjs",
    "prepublishOnly": "make binaries licenses"
  }
}
